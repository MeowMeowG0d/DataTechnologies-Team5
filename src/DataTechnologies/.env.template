NEO4J_URI=neo4j://{HOST}:{PORT}
NEO4J_USER=ENTER_USER
NEO4J_PASSWORD=ENTER_PASSWORD
MONGODB_URI=MONGODB_URI

# PII field-encryption keys. Generate 32-byte Base64 values, e.g. in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
PII_ENCRYPTION_KEY=GENERATE_32_BYTE_BASE64_KEY
PII_INDEX_KEY=GENERATE_32_BYTE_BASE64_KEY
